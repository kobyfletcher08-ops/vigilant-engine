pragma solidity ^0.8.24;
interface Callback {function pancakeCall(address,uint256,uint256,bytes calldata) external;}
interface ERC {function transfer(address,uint256) external returns(bool);function transferFrom(address,address,uint256) external returns(bool);function balanceOf(address) external view returns(uint256);}
contract MockToken {uint8 public decimals=18;mapping(address=>uint256) public balanceOf;mapping(address=>mapping(address=>uint256)) public allowance;function mint(address a,uint256 n) external {balanceOf[a]+=n;}function approve(address a,uint256 n) external returns(bool){allowance[msg.sender][a]=n;return true;}function transfer(address a,uint256 n) external returns(bool){balanceOf[msg.sender]-=n;balanceOf[a]+=n;return true;}function transferFrom(address a,address b,uint256 n) external returns(bool){allowance[a][msg.sender]-=n;balanceOf[a]-=n;balanceOf[b]+=n;return true;}}
contract MockFactory {mapping(bytes32=>address) public pairs;function setPair(address a,address b,address p) external {pairs[keccak256(abi.encode(a,b))]=p;pairs[keccak256(abi.encode(b,a))]=p;}function getPair(address a,address b) external view returns(address){return pairs[keccak256(abi.encode(a,b))];}}
contract MockPair {address public token0;address public token1;bool private locked;constructor(address a,address b){token0=a;token1=b;}function getReserves() external view returns(uint112,uint112,uint32){return(uint112(ERC(token0).balanceOf(address(this))),uint112(ERC(token1).balanceOf(address(this))),uint32(block.timestamp));}function swap(uint256 a,uint256 b,address recipient,bytes calldata data) external {require(!locked,"locked");locked=true;uint256 before0=ERC(token0).balanceOf(address(this));uint256 before1=ERC(token1).balanceOf(address(this));if(a>0)ERC(token0).transfer(recipient,a);if(b>0)ERC(token1).transfer(recipient,b);Callback(recipient).pancakeCall(msg.sender,a,b,data);if(a>0)require(ERC(token0).balanceOf(address(this))>=before0+(a*10000+9974)/9975-a,"repayment");if(b>0)require(ERC(token1).balanceOf(address(this))>=before1+(b*10000+9974)/9975-b,"repayment");locked=false;}}
contract MockRouter {address public factory;address public WETH;uint256 public numerator;uint256 public denominator;constructor(address f,address w,uint256 n,uint256 d){factory=f;WETH=w;numerator=n;denominator=d;}function rate(uint256 n,uint256 d) external {numerator=n;denominator=d;}function getAmountsOut(uint256 amount,address[] calldata) external view returns(uint256[] memory out){out=new uint256[](2);out[0]=amount;out[1]=amount*numerator/denominator;}function swapExactTokensForTokens(uint256 amount,uint256 minimum,address[] calldata path,address recipient,uint256 deadline) external returns(uint256[] memory out){require(deadline>=block.timestamp,"expired");out=new uint256[](2);out[0]=amount;out[1]=amount*numerator/denominator;require(out[1]>=minimum,"slippage");ERC(path[0]).transferFrom(msg.sender,address(this),amount);ERC(path[1]).transfer(recipient,out[1]);}}
